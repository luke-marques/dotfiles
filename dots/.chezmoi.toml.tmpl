{{- $machineTypes := list "personal" "work" -}}
{{- $machineType := promptChoiceOnce
    . "machineType"
    "Is this a personal or work machine"
    $machineTypes
    "personal"
-}}
{{- $isWorkMachine := eq $machineType "work" -}}
{{- $personalEmail := promptStringOnce . "personalEmail" "Personal email" | trim -}}
{{- if not (regexMatch "^[^[:space:]@]+@[^[:space:]@]+$" $personalEmail) }}{{ fail "Enter a non-empty personal email without whitespace" }}{{ end -}}
{{- $workEmail := "" -}}
{{- if $isWorkMachine -}}
    {{- $workEmail = promptStringOnce . "workEmail" "Work Git email" | trim -}}
    {{- if not (regexMatch "^[^[:space:]@]+@[^[:space:]@]+$" $workEmail) }}{{ fail "Enter a non-empty work Git email without whitespace" }}{{ end -}}
{{- end -}}

encryption = "age"

[age]
    identity = {{ joinPath .chezmoi.homeDir ".config/chezmoi/key" | quote }}
    recipient = "age1fsurjn3gejzrd4wwmv5ymnxnuac8w9sx59ulaj0wfy5uph3yv56s9fnnc8"

[data]
    machineType = {{ $machineType | quote }}
    isWorkMachine = {{ $isWorkMachine }}
    personalEmail = {{ $personalEmail | quote }}
{{ if $isWorkMachine -}}
    workEmail = {{ $workEmail | quote }}
{{ end -}}
