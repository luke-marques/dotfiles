hex2rgb() {
  local hex="${1:-$(cat)}"  # Use $1 if provided, otherwise read from stdin
  hex="${hex#\#}"  # Remove # if present
  hex="${hex//[[:space:]]/}"  # Remove any whitespace
  printf "%d %d %d\n" 0x${hex:0:2} 0x${hex:2:2} 0x${hex:4:2}
}
